{
  "name": "fluid-ui-svelte",
  "version": "0.0.1",
  "description": "A pragmatic Svelte 5 component library designed for flexibility and ease of use. It separates low-level semantic wrappers from high-level interactive components, giving you complete control over your application's architecture.",
  "keywords": [
    "svelte"
  ],
  "homepage": "https://github.com/ayazemre/fluid-ui-svelte",
  "license": "MIT",
  "author": {
    "name": "Emre Ayaz",
    "email": "ayazthemre@gmail.com"
  },
  "repository": {
    "url": "git+https://github.com/ayazemre/fluid-ui-svelte.git"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base/index.d.ts",
      "svelte": "./dist/base/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js"
    },
    "./prebuilt": {
      "types": "./dist/prebuilt/index.d.ts",
      "svelte": "./dist/prebuilt/index.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "test:browser": "dotenvx run -- playwright test"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@iconify/svelte": "^5.2.3",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
